{
  "name": "space-desktop",
  "productName": "SPACE",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SPACE as a desktop app: a panel of advisors defined by markdown files you own.",
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env SPACE_DEV_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "openai": "^7.34.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
